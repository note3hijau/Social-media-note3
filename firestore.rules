rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }
    
    // Primitives
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isEmailVerified() {
      return isSignedIn();
    }
    
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }
    
    function incoming() {
      return request.resource.data;
    }
    
    function existing() {
      return resource.data;
    }
    
    function isOwner(ownerId) {
      return isSignedIn();
    }

    // Entity Validations
    function isValidUser(data) {
      return data.id is string && data.username is string && data.displayName is string;
    }
    
    function isValidPost(data) {
      return data.id is string && data.userId is string && data.userName is string && data.content is string && data.createdAt is string;
    }
    
    function isValidMessage(data) {
      return data.id is string && data.senderId is string && data.receiverId is string && data.content is string && data.createdAt is string;
    }
    
    function isValidFriendRequest(data) {
      return data.id is string && data.senderId is string && data.senderName is string && data.receiverId is string && (data.status == 'pending' || data.status == 'accepted' || data.status == 'declined' || data.status == 'cancelled') && data.createdAt is string;
    }
    
    function isValidMarketplaceItem(data) {
      return data.id is string && data.sellerId is string && data.sellerName is string && data.title is string && data.price is int && data.isSold is bool;
    }
    
    function isValidNotification(data) {
      return data.id is string && data.type is string && data.title is string && data.content is string && data.isRead is bool && data.createdAt is string;
    }
    
    function isValidEscrowTransaction(data) {
      return data.id is string && data.itemId is string && data.buyerId is string && data.paymentStatus is string && data.createdAt is string;
    }

    function isValidFriend(data) {
      return data.id is string && data.displayName is string && data.avatar is string;
    }

    // Resource Rules
    match /users/{userId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isSignedIn() && isValidUser(incoming());
      allow update: if isSignedIn() && isValidUser(incoming());
      allow delete: if isSignedIn();
      
      match /friends/{friendId} {
        allow get, list: if isSignedIn();
        allow create, update: if isSignedIn() && isValidFriend(incoming());
        allow delete: if isSignedIn();
      }
    }

    match /closed_accounts/{blockId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if false;
    }
    
    match /posts/{postId} {
      allow read: if isSignedIn();
      allow create: if isEmailVerified() && isValidId(postId) && isOwner(incoming().userId) && isValidPost(incoming());
      allow update: if isEmailVerified() && (
        // Allow the creator to update their original fields (like editing post content)
        (isOwner(existing().userId) && isOwner(incoming().userId) && isValidPost(incoming())) ||
        // Allow other signed in users to like / unlike or comment (updating array fields)
        (incoming().diff(existing()).affectedKeys().hasOnly(['likes', 'comments']))
      );
      allow delete: if isEmailVerified() && isOwner(existing().userId);
    }
    
    match /messages/{messageId} {
      allow read: if isSignedIn();
      allow create: if isEmailVerified() && isValidId(messageId) && isOwner(incoming().senderId) && isValidMessage(incoming());
      allow update: if isEmailVerified() && (isOwner(existing().senderId) || isOwner(existing().receiverId)) && incoming().diff(existing()).affectedKeys().hasOnly(['isRead']);
      allow delete: if isEmailVerified() && (isOwner(existing().senderId) || isOwner(existing().receiverId));
    }
    
    match /friend_requests/{requestId} {
      allow read: if isSignedIn();
      allow create: if isEmailVerified() && isValidId(requestId) && isOwner(incoming().senderId) && isValidFriendRequest(incoming());
      allow update: if isEmailVerified() && (isOwner(existing().senderId) || isOwner(existing().receiverId)) && isValidFriendRequest(incoming());
      allow delete: if isEmailVerified() && (isOwner(existing().senderId) || isOwner(existing().receiverId));
    }
    
    match /marketplace_items/{itemId} {
      allow read: if isSignedIn();
      allow create: if isEmailVerified() && isValidId(itemId) && isOwner(incoming().sellerId) && isValidMarketplaceItem(incoming());
      allow update: if isEmailVerified() && (
        (isOwner(existing().sellerId) && isOwner(incoming().sellerId) && isValidMarketplaceItem(incoming())) ||
        (incoming().diff(existing()).affectedKeys().hasOnly(['isSold', 'buyerId', 'paymentStatus']))
      );
      allow delete: if isEmailVerified() && isOwner(existing().sellerId);
    }
    
    match /notifications/{notificationId} {
      allow read: if isSignedIn();
      allow create: if isEmailVerified() && isValidId(notificationId) && isValidNotification(incoming());
      allow update: if isEmailVerified() && isValidNotification(incoming());
      allow delete: if isEmailVerified();
    }
    
    match /escrow_transactions/{transactionId} {
      allow read: if isSignedIn();
      allow create: if isEmailVerified() && isValidId(transactionId) && isOwner(incoming().buyerId) && isValidEscrowTransaction(incoming());
      allow update: if isEmailVerified() && isValidEscrowTransaction(incoming());
      allow delete: if isEmailVerified();
    }
  }
}
